# Directorios de compilación y artefactos de CMake
build/
build-*/
cmake-build-*/
out/
bin/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
Makefile
*.cmake
!CMakeLists.txt
!tests/CMakeLists.txt

# Archivos objeto, binarios y bibliotecas de enlace
*.o
*.obj
*.so
*.so.*
*.dylib
*.dll
*.a
*.lib
*.exe
*.out
*.app
OBD2_Scanner_Pro
tst_obd_simulator

