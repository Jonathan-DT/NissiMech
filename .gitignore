*.moc
moc_*.cpp
mocs_compilation.cpp
ui_*.h
qrc_*.cpp
*.qmlc
*.jsc
.qt/
.rcc/

# Archivos temporales de SQLite3 (WAL, SHM, Journal)
# Se preserva la base de datos oficial y su esquema
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.db-wal
*.db-shm
*.db-journal

# Excepciones: Conservar base de datos y esquema del proyecto
!database/schema.sql
!database/dtc_codes_es.sqlite

# Entornos de desarrollo y editores (IDEs)
# Qt Creator
*.user
*.user.*
.qtcreator/
CMakeLists.txt.user*

# Visual Studio Code / Cursor
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.history/

# CLion / JetBrains
.idea/

# Visual Studio (MSVC)
